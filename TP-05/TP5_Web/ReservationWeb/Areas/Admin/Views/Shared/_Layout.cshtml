<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ADMINISTRATION</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

</head>
<body>

    <nav class="navbar navbar-dark bg-dark navbar-expand-lg">
        <div class="container-fluid">

            <!-- name + Home icon -->
            <a class="navbar-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">
                ADMINISTRATION
            </a>

            <a class="nav-link text-white ms-2"
               asp-area="" asp-controller="Home" asp-action="Index">
                <i class="fas fa-house"></i>
            </a>


            <!-- toggle Hamburger menu -->
            <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Components of hamburger menu-->
            <div class="collapse navbar-collapse" id="adminNavbar">
                <div class="navbar-nav ms-auto">

                    <a class="nav-link text-white" asp-area="Admin" asp-controller="MenuChoice" asp-action="List">
                        <i class="fas fa-utensils me-1"></i>
                        CHOIX DE MENU
                    </a>

                    <a class="nav-link text-white" asp-area="Admin" asp-controller="Reservation" asp-action="List">
                        <i class="far fa-calendar-check me-1"></i>
                        RÉSERVATIONS
                    </a>

                </div>
            </div>

        </div>
    </nav>
    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="mt-5">

        <!-- Top footer (links) -->
        <div class="container-fluid bg-dark py-3">
            <div class="d-flex justify-content-center gap-4 flex-wrap text-center">

                <a class="nav-link text-white" asp-area="Admin" asp-controller="MenuChoice" asp-action="List">
                    <i class="fas fa-utensils me-1"></i>
                    CHOIX DE MENU
                </a>

                <a class="nav-link text-white" asp-area="Admin" asp-controller="Reservation" asp-action="List">
                    <i class="far fa-calendar-check me-1"></i>
                    RÉSERVATIONS
                </a>

            </div>
        </div>

        <!-- bottom footer (copyright) -->
        <div class="container-fluid text-center py-3">
            <div class="d-flex justify-content-center align-items-center gap-3 flex-wrap">

                <span>&copy; 2026 - ReservationWeb (Henri Pitre, 2432978)</span>

                <a asp-area="" asp-controller="Home" asp-action="Index">
                    Accueil
                </a>

            </div>
        </div>

    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
    <script>
        $(function () {
            $('[title]').tooltip();
        });
    </script>
    <!--
    Section qui permet d'ajouter du JavaScript à partir d'une vue
    Voir la vue Contact/Index.cshtml pour un exemple.
    -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>