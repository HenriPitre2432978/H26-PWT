@using Mastermind.Resources
@model ConfigEditVM

@{
    ViewData["Title"] = Resource.Configurations;
}

<div id="config-page">

    <div class="row">

        <div class="offset-md-2 offset-lg-3 col-md-8 col-lg-6">

            <div class="page-title">
                <h2>@Resource.GlobalConfigurations</h2>
            </div>

            <div class="form-section">
                <form asp-action="Edit">
                    <div class="form-horizontal">
                        <hr />
                        <!-- Configuration fields -->
                        @foreach (var field in new[] { nameof(Model.NbColors), nameof(Model.NbPositions), nameof(Model.NbAttempts) })
                        {
                            <div class="form-group row">

                                <label asp-for="@field" class="col-form-label col-md-6"></label>

                                <div class="col-md-6">

                                    <input asp-for="@field" class="form-control" />

                                    <span asp-validation-for="@field" class="text-danger"></span>
                                </div>
                            </div>
                        }
                        <hr />
                    </div>

                    <div class="text-center">
                        <input type="submit" value="@Resource.Edit" class="btn btn-primary" />
                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}