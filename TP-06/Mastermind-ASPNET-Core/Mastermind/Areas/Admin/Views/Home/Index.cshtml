@using Mastermind.Resources
@model HomeVM

@{
    ViewData["Title"] = Resource.Dashboard;
}

<div id="dashboard-page">

    <div class="row">
        <div class="col-12">

            <div class="page-title">
                <h2>@Resource.Dashboard</h2>
            </div>

        </div>
    </div>

    <div class="row">

        <div class="col-md-6">
            <div id="barchart" class="chart"></div>
        </div>

        <div class="col-md-6">
            <div id="piechart" class="chart"></div>
        </div>

    </div>
</div>

@section Scripts
{
    <script type="text/javascript"
            src="https://www.gstatic.com/charts/loader.js"></script>

    <script type="text/javascript">

        google.charts.load('current', { 'packages': ['corechart'] });

        google.charts.setOnLoadCallback(drawBarChart);
        google.charts.setOnLoadCallback(drawPieChart);

        function drawBarChart() {

            var data = google.visualization.arrayToDataTable([
                ["Element", "Value", { role: "style" }],
                ["@Resource.Colors", @Model.NbColors, "color: gold"],
                ["@Resource.Positions", @Model.NbPositions, "color: orange"],
                ["@Resource.Attempts", @Model.NbAttempts, "color: blue"]
            ]);

            var view = new google.visualization.DataView(data);

            view.setColumns([
                0,
                1,
                {
                    calc: "stringify",
                    sourceColumn: 1,
                    type: "string",
                    role: "annotation"
                },
                2
            ]);

            var options = {
                bar: { groupWidth: "95%" },
                fontSize: 14,
                legend: { position: "none" },
                responsive: true,
                title: "@Resource.CurrentConfigurations"
            };

            var chart =
                new google.visualization.BarChart(
                    document.getElementById("barchart")
                );

            chart.draw(view, options);
        }

        function drawPieChart() {

            var data = google.visualization.arrayToDataTable([
            ['@Resource.Result', '@Resource.Quantity'],
        ['@Resource.Won', @Model.TotalWins],
        ['@Resource.Lost', @Model.TotalLosses]
            ]);

            var options = {
                fontSize: 14,
                is3D: true,
                responsive: true,
                slices: [
                    { color: 'blue', offset: 0.1 },
                    { color: 'orange', offset: 0.1 },
                ],
                title: '@Resource.GameSummary'
            };

            var chart =
                new google.visualization.PieChart(
                    document.getElementById('piechart')
                );

            chart.draw(data, options);
        }

        window.onresize = function () {
            drawBarChart();
            drawPieChart();
        };

    </script>
}