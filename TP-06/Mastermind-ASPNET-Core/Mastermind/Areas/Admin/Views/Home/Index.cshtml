@using Mastermind.Resources
@model HomeVM

@{
    ViewData["Title"] = Resource.Dashboard;
}

<div id="dashboard-page">

    <div class="row">
        <div class="col-12">

            <div class="page-title">
                <h2>@Resource.Dashboard</h2>
            </div>

        </div>
    </div>

    <div class="row">

        <div class="col-md-6">
            <div id="barchart" class="chart"></div>
        </div>

        <div class="col-md-6">
            <div id="piechart" class="chart"></div>
        </div>

    </div>

</div>

@section Scripts
{
    <script type="text/javascript"
            src="https://www.gstatic.com/charts/loader.js"></script>

    <script type="text/javascript">

        google.charts.load('current', { packages: ['corechart'] });

        // Draw charts once Google Charts is loaded
        ['drawBarChart', 'drawPieChart']
            .forEach(callback => google.charts.setOnLoadCallback(window[callback]));

        // Shared chart data
        const configData = [
            ["@Resource.Colors", @Model.NbColors, "color: gold"],
            ["@Resource.Positions", @Model.NbPositions, "color: orange"],
            ["@Resource.Attempts", @Model.NbAttempts, "color: blue"]
        ];

        function drawBarChart() {

            const data = google.visualization.arrayToDataTable([
                ["Element", "Value", { role: "style" }],
                ...configData
            ]);

            const view = new google.visualization.DataView(data);

            // Adds value labels above each bar
            view.setColumns([
                0,
                1,
                {
                    calc: "stringify",
                    sourceColumn: 1,
                    type: "string",
                    role: "annotation"
                },
                2
            ]);

            const options = {
                bar: { groupWidth: "95%" },
                fontSize: 14,
                legend: { position: "none" },
                responsive: true,
                title: "@Resource.CurrentConfigurations"
            };

            new google.visualization.BarChart(
                document.getElementById("barchart")
            ).draw(view, options);
        }

        function drawPieChart() {

            const data = google.visualization.arrayToDataTable([
                ['@Resource.Result', '@Resource.Quantity'],
                ['@Resource.Won', @Model.TotalWins],
                ['@Resource.Lost', @Model.TotalLosses]
            ]);

            const options = {
                fontSize: 14,
                is3D: true,
                responsive: true,
                title: '@Resource.GameSummary',

                // Highlight slices slightly
                slices: [
                    { color: 'blue', offset: 0.1 },
                    { color: 'orange', offset: 0.1 }
                ]
            };

            new google.visualization.PieChart(
                document.getElementById('piechart')
            ).draw(data, options);
        }

        // Redraw charts when window size changes
        window.onresize = () => {
            drawBarChart();
            drawPieChart();
        };

    </script>
}