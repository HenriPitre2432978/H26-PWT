@using Mastermind.Resources

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>

    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @Resource.Administration</title>

    <link rel="icon" href="~/favicon.ico">

    @foreach (var stylesheet in new[] {
        "https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.2.3/css/bootstrap.min.css",
        "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"})
    {
        <link rel="stylesheet" href="@stylesheet" />
    }

    <link rel="stylesheet"
          href="~/Admin/assets/css/admin-bootstrap.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Admin/assets/css/admin.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Links", required: false)

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-area="Admin"
                   asp-controller="Home"
                   asp-action="Index">

                    @Resource.Administration
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex">

                    <!-- LEFT NAVIGATION -->
                    <ul class="navbar-nav">

                        @foreach (var link in new[] {
                                                new{Text = Resource.Rules,Controller = "Home",Action = "Index",Fragment = "rules"},
                                                new{Text = Resource.PlayGame,Controller = "Game",Action = "Index",Fragment = ""}})
                        {
                            <li class="nav-item">

                                <a class="nav-link text-light"
                                   asp-area=""
                                   asp-controller="@link.Controller"
                                   asp-action="@link.Action"
                                   asp-fragment="@link.Fragment">

                                    @link.Text
                                </a>

                            </li>
                        }

                    </ul>

                    <!-- RIGHT NAVIGATION -->
                    <ul class="navbar-nav ms-auto">

                        @if (!User.Identity.IsAuthenticated)
                        {
                            @foreach (var link in new[]
                                                    {
                                                new { Text = Resource.Login, Action = "Login" },
                                                new { Text = Resource.Signup, Action = "Signup" }
                                                })
                            {
                                <li class="nav-item">

                                    <a class="nav-link text-light"
                                       asp-controller="Client"
                                       asp-action="@link.Action">

                                        @link.Text
                                    </a>

                                </li>
                            }
                        }

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">

                                <span class="nav-link text-warning">
                                    @User.Identity.Name
                                </span>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-light"
                                   asp-area=""
                                   asp-controller="Client"
                                   asp-action="Logout">

                                    @Resource.Logout
                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container-fluid">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <footer class="border-top footer text-muted">

        <div class="languages">

            <!-- Language selector -->
            @foreach (var language in new[]
                        {
                        new { Code = "fr", Name = "Français" },
                        new { Code = "en", Name = "English" }
                        })
            {
                <a asp-area="" asp-controller="Language" asp-action="Change" asp-route-lang="@language.Code" asp-route-returnurl="@Context.Request.Path">
                    @language.Name
                </a>
            }

        </div>

        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    &copy; CCHIC - Mastermind -
                    <a asp-area="" asp-controller="Home" asp-action="Index">
                        @Resource.Website
                    </a>
                </div>
            </div>
        </div>
    </footer>

    @foreach (var script in new[]
        {
        "https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.3/jquery.min.js",
        "https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js",
        "https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.2.3/js/bootstrap.min.js"
        })
    {
        <script src="@script"></script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>